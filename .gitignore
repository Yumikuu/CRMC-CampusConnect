# ═══════════════════════════════════════════════════════════
# CRMC CampusConnect — .gitignore
# Prevents unnecessary/sensitive files from being committed
# ═══════════════════════════════════════════════════════════

# ── API Keys & Secrets ──
config.js

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo

# ── OS Generated Files ──
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
._*

# ── Node (if ever added) ──
node_modules/
package-lock.json
yarn.lock

# ── Logs ──
*.log
npm-debug.log*

# ── Environment files ──
.env
.env.local
.env.production

# ── Build output ──
dist/
build/
.cache/

# ── Kiro workspace ──
.kiro/
